---

<section id="stack">
    <h2><span class="serialNo">03</span> Stack</h2>
    <div class="stacks">
        {stack.map((item)=>(
            <div class="stackItem">
              <span class="svg" set:html={item.logo}></span>
              -
              <span>{item.name}</span>
            </div>
))}
    </div>
</section>
<style>
    section{
        margin-top: clamp(1rem, 7vw, 10rem);
    }
    h2{
        font-family: 'Jersey 10', sans-serif;
      color: #9FB191;
      font-size: clamp(2rem,2vw + 1rem,2.3rem);
      border-bottom: 1px dashed rgb(159, 177, 145,0.5);
      padding-bottom: 2px;
      font-weight:100 ;

    }
    .serialNo{
        font-size: 1.4rem;
    }
    .svg :global(svg) {
    width: 1.4em;
    height:auto;
}

.stacks{
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap:1rem;
    margin-top:1.5rem ;
    font-family:'JetBrains Mono',sans-serif ;
}

.stackItem{
  border-bottom: 1px dashed rgba(179, 200, 154,0.4);
  padding-bottom: 1rem;
  color: #B3C89A;
  display: flex;
  align-items: center;
  gap:1rem;
}
.stackItem span:nth-child(2){
color: #B3C89A;
}

</style>