---
const navLinks = [
    {name:'About',url:'#about'},
    {name:'Projects',url:'#projects'},
    {name:'Stack',url:'#stack'},
    {name:'Contact',url:'#contact'},
    {name:'Commits',url:'#commits'}
]
const ontoggle = ()=>{
    const menu = document.querySelector('.menu')
    menu?.classList.toggle('open')
}
---

<header>
    <nav>
        <a class="brand" href="/">
            <svg fill="#A7C080" viewBox="0 0 495.398 495.398" xmlns="http://www.w3.org/2000/svg">
                <path d="M487.083,225.514l-75.08-75.08V63.704c0-15.682-12.708-28.391-28.413-28.391c-15.669,0-28.377,12.709-28.377,28.391 v29.941L299.31,37.74c-27.639-27.624-75.694-27.575-103.27,0.05L8.312,225.514c-11.082,11.104-11.082,29.071,0,40.158 c11.087,11.101,29.089,11.101,40.172,0l187.71-187.729c6.115-6.083,16.893-6.083,22.976-0.018l187.742,187.747 c5.567,5.551,12.825,8.312,20.081,8.312c7.271,0,14.541-2.764,20.091-8.312C498.17,254.586,498.17,236.619,487.083,225.514z"/>
                <path d="M257.561,131.836c-5.454-5.451-14.285-5.451-19.723,0L72.712,296.913c-2.607,2.606-4.085,6.164-4.085,9.877v120.401 c0,28.253,22.908,51.16,51.16,51.16h81.754v-126.61h92.299v126.61h81.755c28.251,0,51.159-22.907,51.159-51.159V306.79 c0-3.713-1.465-7.271-4.085-9.877L257.561,131.836z"/>
            </svg>
            <span>Srujan Petumpuri</span>
        </a>

        <ul class="menu">
            {navLinks.map((link) => (
                <li><a href={link.url}>{link.name}</a></li>
            ))}
            <li>
                <a href="https://github.com/SrujanPetumpurai" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
                    <svg class="github-icon" fill="#9FB191" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M12.026 2c-5.509 0-9.974 4.465-9.974 9.974 0 4.406 2.857 8.145 6.821 9.465.499.09.679-.217.679-.481 0-.237-.008-.865-.011-1.696-2.775.602-3.361-1.338-3.361-1.338-.452-1.152-1.107-1.459-1.107-1.459-.905-.619.069-.605.069-.605 1.002.07 1.527 1.028 1.527 1.028.89 1.524 2.336 1.084 2.902.829.091-.645.351-1.085.635-1.334-2.214-.251-4.542-1.107-4.542-4.93 0-1.087.389-1.979 1.024-2.675-.101-.253-.446-1.268.099-2.64 0 0 .837-.269 2.742 1.021a9.582 9.582 0 0 1 2.496-.336 9.554 9.554 0 0 1 2.496.336c1.906-1.291 2.742-1.021 2.742-1.021.545 1.372.203 2.387.099 2.64.64.696 1.024 1.587 1.024 2.675 0 3.833-2.33 4.675-4.552 4.922.355.308.675.916.675 1.846 0 1.334-.012 2.41-.012 2.737 0 .267.178.577.687.479C19.146 20.115 22 16.379 22 11.974 22 6.465 17.535 2 12.026 2z"/>
                    </svg>
                </a>
            </li>
        </ul>
        <button class="hamburger" >
            <svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" width="100%" height="100%" viewBox="0,0,256,256">
            <g fill="#d7d9af" fill-rule="nonzero" stroke="none" stroke-width="1" stroke-linecap="butt" stroke-linejoin="miter" stroke-miterlimit="10" stroke-dasharray="" stroke-dashoffset="0" font-family="none" font-weight="none" font-size="none" text-anchor="none" style="mix-blend-mode: normal"><g transform="scale(5.12,5.12)"><path d="M3,9c-0.36064,-0.0051 -0.69608,0.18438 -0.87789,0.49587c-0.18181,0.3115 -0.18181,0.69676 0,1.00825c0.18181,0.3115 0.51725,0.50097 0.87789,0.49587h44c0.36064,0.0051 0.69608,-0.18438 0.87789,-0.49587c0.18181,-0.3115 0.18181,-0.69676 0,-1.00825c-0.18181,-0.3115 -0.51725,-0.50097 -0.87789,-0.49587zM3,24c-0.36064,-0.0051 -0.69608,0.18438 -0.87789,0.49587c-0.18181,0.3115 -0.18181,0.69676 0,1.00825c0.18181,0.3115 0.51725,0.50097 0.87789,0.49587h44c0.36064,0.0051 0.69608,-0.18438 0.87789,-0.49587c0.18181,-0.3115 0.18181,-0.69676 0,-1.00825c-0.18181,-0.3115 -0.51725,-0.50097 -0.87789,-0.49587zM3,39c-0.36064,-0.0051 -0.69608,0.18438 -0.87789,0.49587c-0.18181,0.3115 -0.18181,0.69676 0,1.00825c0.18181,0.3115 0.51725,0.50097 0.87789,0.49587h44c0.36064,0.0051 0.69608,-0.18438 0.87789,-0.49587c0.18181,-0.3115 0.18181,-0.69676 0,-1.00825c-0.18181,-0.3115 -0.51725,-0.50097 -0.87789,-0.49587z"></path></g></g>
            </svg>
        </button>
    </nav>
</header>

<style>
    header {
        background-image: linear-gradient(to bottom, #21282D, #2D3639);
        width: 100%;
    }

    nav {
        display: flex;
        position: relative;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding: 1rem clamp(1rem, 4vw, 2rem);
        max-width: 1000px;
        margin: 0 auto;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        text-decoration: none;
        color: #E2DBC8;
        font-family: 'Pixelify Sans', monospace;
        font-size: clamp(0.8rem, 2vw, 1rem);
        white-space: nowrap;
    }

    .brand svg {
        width: clamp(0.9rem, 2vw, 1.1rem);
        height: clamp(0.9rem, 2vw, 1.1rem);
        flex-shrink: 0;
    }

    ul {
        display: flex;
        align-items: center;
        list-style: none;
        gap: clamp(0.8rem, 2vw, 2rem);
        margin: 0;
        padding: 0;
    }
    .hamburger{
        display: none;
    }
    @media(max-width:768px){
        .menu{
            display: none;
        }
        .menu.open {
            display:flex;
            flex-direction:column;
            gap:2rem;
            position: absolute;  
            background-image: linear-gradient(to bottom, #21282D, #2D3639);
            right:0;
            top:0;
            width: 30vw;
            height: 100vh;
            padding: 1rem;
            font-family:"Pixelify Sans",sans-serif ;
        }
        .hamburger{
            display: flex;
            width: 2rem;
            height: 2rem;
            border-radius: 10%;
            border: 2px solid #E2DBC8;
        }
    }

    ul li a {
        text-decoration: none;
        color: #9FB191;
        font-size: clamp(0.75rem, 1.5vw, 0.95rem);
        white-space: nowrap;
    }

    ul li a:hover {
        color: #E2DBC8;
    }

    .github-icon {
        display: block;
        width: clamp(0.9rem, 2vw, 1.1rem);
        height: clamp(0.9rem, 2vw, 1.1rem);
    }

</style>
<script>
    const hamburger = document.querySelector('.hamburger');
    hamburger?.addEventListener('click', () => {
        document.querySelector('.menu')?.classList.toggle('open');
    });
</script>